# Copy to .env to override the development credentials in compose.dev.yaml
# (compose.yaml includes it).
POSTGRES_USER=trelis
POSTGRES_PASSWORD=trelis
NEO4J_PASSWORD=trelis-dev
# silo's root credentials, which Trelis also uses for its bucket.
S3_ACCESS_KEY_ID=trelis
S3_SECRET_ACCESS_KEY=trelis-dev-secret

# Not read by compose: `make test` and `make test-linked` use the dev Postgres
# automatically; export this to point the Postgres-backed tests elsewhere.
# TRELIS_TEST_POSTGRES_DSN=postgres://trelis:trelis@localhost:5432/trelis?sslmode=disable
